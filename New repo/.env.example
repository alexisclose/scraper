# Logging — pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Set to "1" for pretty-printed logs in dev (default in non-prod NODE_ENV)
LOG_PRETTY=

# Tesla scraper — Chrome DevTools Protocol bridge
TESLA_CDP_PORT=9223
# Override the auto-detected Chrome / Edge / Brave path if needed
TESLA_CHROME=

# VW scraper — set to "1" to skip the on-disk slug-discovery cache
VW_NO_CACHE=

# Audi scraper
# Number of browsers run in parallel across the model sweep
AUDI_CONCURRENCY=3
# Set to "1" to drive the configurator with a visible browser
AUDI_HEADFUL=
# Restrict the sweep to specific model ids (comma-separated) — debugging aid,
# e.g. AUDI_MODELS=a3-sportback. Empty = every candidate model.
AUDI_MODELS=

# HTTP fetcher
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=3
HTTP_CONCURRENCY=8

# Output directory roots (defaults shown)
DATA_DIR=./data
